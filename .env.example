# Agent Roundtable configuration example.
# Copy to .env if your launcher supports it, or export these variables manually.

# HTTP port bound to 127.0.0.1 only.
R2_PORT=8820

# Runtime data directory (database, shared snapshots, turns, TTS cache).
R2_DATA_DIR=./data

# Shared secret used by the human UI/API. If empty, a random token is generated
# and written to <R2_DATA_DIR>/room-token.txt.
R2_HUMAN_TOKEN=

# 1 = every participant is served by the deterministic offline MockProvider.
# 0 = real Codex / Claude Code CLI providers.
R2_PROVIDER_MOCK=0

# Claude Code CLI through the local MagPie gateway.
R2_MAGPIE_BASE=http://127.0.0.1:3425
R2_MAGPIE_KEY=magpie
R2_CC_MODEL=group/openrouter

# Optional Codex model override.
R2_CODEX_MODEL=

# Extra read-only project roots for the shared-file picker (semicolon separated).
# The repository root is always allowed.
R2_SHARED_ROOTS=

# Approval lifetime for write tasks, milliseconds (default 15 minutes).
R2_APPROVAL_TTL_MS=900000

# Optional custom ASR command; arguments must be a JSON array.
R2_ASR_CMD=
R2_ASR_ARGS=[]
R2_WHISPER_MODEL=
R2_WHISPER_PROMPT=
